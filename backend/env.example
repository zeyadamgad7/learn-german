# =============================================================================
# German Grammar Analyzer API - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Do not commit .env to version control (it's in .gitignore)

# =============================================================================
# 🤖 GROQ API CONFIGURATION (REQUIRED)
# =============================================================================
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model configuration
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct  # Default model for analysis
GROQ_TIMEOUT=30                                        # Request timeout in seconds
GROQ_MAX_TOKENS=1024                                   # Maximum tokens per response

# =============================================================================
# 🌍 APPLICATION ENVIRONMENT
# =============================================================================
ENVIRONMENT=development  # Options: development, staging, production

# Application metadata
APP_NAME=German Grammar Analyzer
APP_VERSION=1.0.0
APP_DESCRIPTION=Analyze German sentences for grammar, parts of speech, and grammatical roles

# =============================================================================
# 💾 REDIS CACHE CONFIGURATION
# =============================================================================
# Redis connection settings
REDIS_URL=redis://localhost:6379           # Redis connection URL
REDIS_PASSWORD=                            # Redis password (leave empty if none)
REDIS_DB=0                                 # Redis database number (0-15)
REDIS_MAX_CONNECTIONS=10                   # Maximum Redis connections in pool

# Cache behavior
CACHE_ENABLED=true                         # Enable/disable caching (true/false)
CACHE_TTL=3600                            # Cache TTL in seconds (3600 = 1 hour)
CACHE_KEY_PREFIX=grammar_analysis         # Prefix for cache keys
CACHE_MAX_MEMORY_POLICY=allkeys-lru       # Redis memory eviction policy

# Cache timeouts and retries
REDIS_SOCKET_TIMEOUT=5                    # Socket timeout in seconds
REDIS_SOCKET_CONNECT_TIMEOUT=5            # Connection timeout in seconds
REDIS_RETRY_ON_TIMEOUT=true               # Retry on timeout (true/false)
REDIS_HEALTH_CHECK_INTERVAL=30            # Health check interval in seconds

# =============================================================================
# 🌐 SERVER CONFIGURATION
# =============================================================================
# Basic server settings
HOST=0.0.0.0                              # Server host (0.0.0.0 for all interfaces)
PORT=8000                                 # Server port
WORKERS=1                                 # Number of worker processes (production)

# Request limits
MAX_SENTENCE_LENGTH=500                   # Maximum sentence length in characters
MAX_WORDS_PER_SENTENCE=50                # Maximum words per sentence
REQUEST_TIMEOUT=30                        # Request timeout in seconds

# =============================================================================
# 🛡️ SECURITY CONFIGURATION
# =============================================================================
# CORS settings
CORS_ALLOW_ORIGINS=*                      # Allowed origins (* for all in dev, specific domains in prod)
CORS_ALLOW_CREDENTIALS=true               # Allow credentials in CORS
CORS_ALLOW_METHODS=GET,POST,OPTIONS       # Allowed HTTP methods
CORS_ALLOW_HEADERS=*                      # Allowed headers

# Trusted hosts (production)
TRUSTED_HOSTS=localhost,127.0.0.1,*.localhost  # Comma-separated list of trusted hosts

# Rate limiting
RATE_LIMIT_ANALYZE=5/minute               # Rate limit for analyze endpoint
RATE_LIMIT_HEALTH=30/minute               # Rate limit for health endpoint
RATE_LIMIT_ADMIN=2/minute                 # Rate limit for admin endpoints

# Content Security Policy
CSP_DEFAULT_SRC=self                      # Default CSP source
CSP_SCRIPT_SRC=self,unsafe-inline,unsafe-eval,https://cdn.jsdelivr.net,https://unpkg.com
CSP_STYLE_SRC=self,unsafe-inline,https://cdn.jsdelivr.net,https://unpkg.com

# =============================================================================
# 📊 LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO                            # Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=                                 # Log file path (empty for console only)
LOG_MAX_SIZE=10485760                     # Max log file size in bytes (10MB)
LOG_BACKUP_COUNT=5                        # Number of backup log files

# Structured logging
LOG_JSON=false                            # Use JSON format for logs (true/false)
LOG_CORRELATION_ID=true                   # Include correlation IDs (true/false)

# =============================================================================
# 🔒 SSL/TLS CONFIGURATION (PRODUCTION)
# =============================================================================
# SSL certificates for HTTPS
SSL_KEYFILE=                              # Path to SSL private key file
SSL_CERTFILE=                             # Path to SSL certificate file
SSL_CA_CERTS=                             # Path to SSL CA certificate file
SSL_CERT_REQS=0                           # SSL certificate requirements (0=none, 1=optional, 2=required)

# Security headers
FORCE_HTTPS=false                         # Redirect HTTP to HTTPS (true/false)
HSTS_MAX_AGE=31536000                     # HSTS max age in seconds (1 year)
HSTS_INCLUDE_SUBDOMAINS=true              # Include subdomains in HSTS

# =============================================================================
# 📈 MONITORING & HEALTH CHECKS
# =============================================================================
# Health check configuration
HEALTH_CHECK_TIMEOUT=10                   # Health check timeout in seconds
HEALTH_CHECK_GROQ=true                    # Include Groq API in health checks
HEALTH_CHECK_REDIS=true                   # Include Redis in health checks

# Metrics and monitoring
ENABLE_METRICS=true                       # Enable metrics collection
METRICS_PATH=/metrics                     # Metrics endpoint path
ENABLE_TRACING=false                      # Enable request tracing

# =============================================================================
# 🧪 DEVELOPMENT & TESTING
# =============================================================================
# Development features
DEBUG=false                               # Enable debug mode (true/false)
RELOAD=false                              # Enable auto-reload in development
DOCS_URL=/docs                            # API documentation URL
REDOC_URL=/redoc                          # ReDoc documentation URL
OPENAPI_URL=/openapi.json                 # OpenAPI schema URL

# Testing configuration
TEST_MODE=false                           # Enable test mode
TEST_SKIP_AUTH=false                      # Skip authentication in tests
TEST_MOCK_GROQ=false                      # Mock Groq API responses in tests

# =============================================================================
# 🚀 PRODUCTION DEPLOYMENT
# =============================================================================
# Production domains
PRODUCTION_DOMAINS=yourdomain.com,api.yourdomain.com  # Comma-separated production domains

# Database URL (if using persistent storage in future)
DATABASE_URL=                             # Future: PostgreSQL connection URL

# External services
SENTRY_DSN=                               # Sentry error tracking DSN
DATADOG_API_KEY=                          # DataDog monitoring API key
NEW_RELIC_LICENSE_KEY=                    # New Relic monitoring license key

# Container orchestration
CONTAINER_NAME=german-grammar-analyzer    # Container name
NAMESPACE=default                         # Kubernetes namespace
REPLICA_COUNT=1                           # Number of replicas

# =============================================================================
# 🌍 INTERNATIONALIZATION
# =============================================================================
DEFAULT_LANGUAGE=de                       # Default language (German)
SUPPORTED_LANGUAGES=de,en                 # Supported languages
TIMEZONE=Europe/Berlin                    # Default timezone

# =============================================================================
# 📚 API DOCUMENTATION
# =============================================================================
API_TITLE=German Grammar Analyzer
API_DESCRIPTION=Analyze German sentences for grammar, parts of speech, and grammatical roles with Redis caching
API_VERSION=1.0.0
API_CONTACT_NAME=Your Name
API_CONTACT_EMAIL=your.email@example.com
API_CONTACT_URL=https://github.com/yourusername/learnmen
API_LICENSE_NAME=MIT
API_LICENSE_URL=https://opensource.org/licenses/MIT

# =============================================================================
# 🔧 ADVANCED CONFIGURATION
# =============================================================================
# Performance tuning
UVICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
UVICORN_BACKLOG=2048                      # Socket backlog size
UVICORN_MAX_REQUESTS=1000                 # Max requests per worker
UVICORN_MAX_REQUESTS_JITTER=100           # Random jitter for max requests

# Memory management
MAX_MEMORY_USAGE=512MB                    # Maximum memory usage
GARBAGE_COLLECTION_THRESHOLD=100          # GC threshold

# Request processing
MAX_REQUEST_SIZE=1048576                  # Max request size in bytes (1MB)
MAX_CONCURRENT_REQUESTS=100               # Max concurrent requests

# =============================================================================
# Example configurations for different environments:
# =============================================================================

# DEVELOPMENT EXAMPLE:
# ENVIRONMENT=development
# DEBUG=true
# RELOAD=true
# CORS_ALLOW_ORIGINS=*
# LOG_LEVEL=DEBUG
# CACHE_TTL=300
# REDIS_URL=redis://localhost:6379

# PRODUCTION EXAMPLE:
# ENVIRONMENT=production
# DEBUG=false
# RELOAD=false
# CORS_ALLOW_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
# LOG_LEVEL=INFO
# CACHE_TTL=3600
# REDIS_URL=redis://redis-cluster:6379
# SSL_KEYFILE=/etc/ssl/private/server.key
# SSL_CERTFILE=/etc/ssl/certs/server.crt
# TRUSTED_HOSTS=yourdomain.com,api.yourdomain.com

# DOCKER COMPOSE EXAMPLE:
# REDIS_URL=redis://redis:6379
# HOST=0.0.0.0
# PORT=8000

# =============================================================================
